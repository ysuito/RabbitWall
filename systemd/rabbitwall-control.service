[Unit]
Description=RABBITWALL internet gate and node health controller
Requires=nftables.service
After=nftables.service network.target
Before=rabbitwall-web.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/rabbitwall/control.py run
ExecStopPost=/usr/bin/python3 /opt/rabbitwall/control.py off
Restart=on-failure
RestartSec=3
User=root
Group=rabbitwall-control
SupplementaryGroups=rabbitwall-dns rabbitwall-requests
RuntimeDirectory=rabbitwall rabbitwall-requests
RuntimeDirectoryMode=0750
LogsDirectory=rabbitwall
LogsDirectoryMode=0700
UMask=0027
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/rabbitwall-nodes /etc/nftables.d /etc/rabbitwall-domain-policy
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
MemoryMax=96M

[Install]
WantedBy=multi-user.target
